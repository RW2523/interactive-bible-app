# ---------------------------------------------------------------------------
# Interactive Bible App — local configuration
# Copy to .env (scripts/setup.sh does this for you). Everything runs locally;
# the ONLY remote service is the Gemini API.
# ---------------------------------------------------------------------------

# --- Gemini (required for AI features) ------------------------------------------
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model aliases are resolved by the API; if a model is unavailable the fallbacks are tried in order.
GEMINI_MODEL_ANALYSIS=gemini-flash-latest
GEMINI_MODEL_FAST=gemini-flash-lite-latest
GEMINI_MODEL_TRANSCRIBE=gemini-flash-latest
GEMINI_MODEL_FALLBACKS=gemini-3-flash-preview,gemini-2.5-flash,gemini-flash-latest
GEMINI_EMBED_MODEL=gemini-embedding-001
# Must match the vector(768) columns in backend/migrations/001_init.sql
EMBEDDING_DIM=768
GEMINI_MAX_RPM=60
GEMINI_CONCURRENCY=4
GEMINI_DAILY_TOKEN_BUDGET=5000000
# Optional: set only for models that support a thinking budget (e.g. 0 to disable thinking on 2.5 Flash)
# GEMINI_THINKING_BUDGET=0
# Estimated prices (USD per million tokens) used for cost metrics
GEMINI_PRICE_INPUT_PER_MTOK=0.30
GEMINI_PRICE_OUTPUT_PER_MTOK=2.50
GEMINI_PRICE_EMBED_PER_MTOK=0.15
# Embed the Bible corpus automatically in the background when the API starts (resumable)
EMBED_BIBLE_ON_START=true

# --- Gemini images + narration (Sermon Studio visuals & slide scenes, Explore story videos & event illustrations) ---
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# used when "high quality" is ticked
GEMINI_IMAGE_MODEL_HQ=gemini-3-pro-image
GEMINI_IMAGE_FALLBACKS=gemini-2.5-flash-image,gemini-3-pro-image-preview
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TTS_FALLBACKS=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Kore
GEMINI_PRICE_IMAGE_OUTPUT_PER_MTOK=30
GEMINI_PRICE_TTS_OUTPUT_PER_MTOK=10
# Per signed-in user, per hour: sermon polish/visuals/outreach and Explore content/stories/illustrations
AI_CREATIVE_CALLS_PER_HOUR=120

# --- Local services ------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://interactive_bible@localhost:54329/interactive_bible
TEST_DATABASE_URL=postgresql+psycopg://interactive_bible@localhost:54329/interactive_bible_test
PG_PORT=54329
# PG_BIN=/opt/homebrew/opt/postgresql@17/bin
API_PORT=8000
WEB_PORT=5173
# Where `make start` listens: 0.0.0.0 = other devices on your network can open the app (they still sign in),
# 127.0.0.1 = this computer only
API_HOST=0.0.0.0
# Address share links use, e.g. https://bible.example.org (empty = this computer's address on your network)
PUBLIC_BASE_URL=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Security -----------------------------------------------------------------------------
# setup.sh replaces both with random values
SECRET_KEY=change-me
TOKEN_TTL_HOURS=72
# Password of the sample accounts (admin/editor/member/outsider @interactivebible.local), for signing in on other devices
DEMO_PASSWORD=
# Let visitors create their own (member) accounts on the sign-up page
ALLOW_SIGNUP=true
# Personal mode: no sign-in on this computer - every request from localhost acts as the owner account (full admin access).
# Other devices on your network still sign in with an account, unless SINGLE_USER_TRUST_NETWORK=true
# (then ANYONE who can reach the port gets full access, including your Gemini key's usage).
SINGLE_USER_MODE=true
OWNER_USER_ID=usr_admin
SINGLE_USER_TRUST_NETWORK=false

# --- Pipeline & policy -----------------------------------------------------------------
PIPELINE_VERSION=scripture-intelligence-1.0
DEFAULT_TRANSLATION=web
TRANSCRIBE_CHUNK_SECONDS=300
OFFICIAL_REQUIRES_REVIEW=true
FEEDBACK_HIDE_THRESHOLD=3
SEMANTIC_CANDIDATES=20
SEMANTIC_MAX_ACCEPTED=5

# --- Uploads & abuse controls ------------------------------------------------------------
MAX_UPLOAD_MB_MEDIA=1024
MAX_UPLOAD_MB_DOCUMENT=50
ALLOW_PRIVATE_URL_FETCH=false
RATE_LIMIT_PER_MINUTE=120
ASK_RATE_LIMIT_PER_MINUTE=12

# Gemini 3 family: thinking level used for extraction prompts (LOW|MEDIUM|HIGH; MINIMAL only on some models, and a level the model rejects falls back to its default)
GEMINI_THINKING_LEVEL=LOW

# --- Background worker -------------------------------------------------------------------
# On stop, running jobs get this long to finish before they are handed back to the queue (no attempt is spent)
WORKER_SHUTDOWN_GRACE_SECONDS=4
# Running jobs of a worker that has not sent a heartbeat for this long are requeued (crash / kill -9)
WORKER_HEARTBEAT_STALE_SECONDS=120
